# Plantilla de variables de entorno del backend (SIN secretos reales).
# Copia este archivo a `.env` (que esta en .gitignore) y completa los valores.
# NUNCA commitees `.env` ni credenciales reales.
#
# Nota: Spring Boot NO carga `.env` automaticamente. Usa estas variables como
# variables de entorno del sistema/terminal, o configuralas en tu IDE / Railway.

# --- Base de datos (PostgreSQL) ---
# Para Docker Compose local: si usas el puerto por defecto, deja 5432.
# Si levantaste la base con DB_PORT=5433, cambia el puerto aqui a 5433.
DATABASE_URL=jdbc:postgresql://localhost:5432/londono_distribuciones
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=postgres

# --- JWT ---
# JWT_SECRET debe tener al menos 32 caracteres (256 bits para HS256).
JWT_SECRET=change-me-with-a-long-random-secret-at-least-32-chars
JWT_ACCESS_EXPIRATION=900000        # 15 minutos (ms)
JWT_REFRESH_EXPIRATION=604800000    # 7 dias (ms)

# --- Cloudinary (imagenes) ---
# Si se dejan vacias, el backend arranca igual; la subida real de imagenes
# quedara deshabilitada hasta configurar credenciales validas.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Frontend / CORS ---
FRONTEND_URL=http://localhost:3000

# --- Contacto ---
WHATSAPP_PHONE_NUMBER=

# --- Seed del administrador inicial (solo si la tabla users esta vacia) ---
# Cambia la contrasena tras el primer arranque en cualquier entorno real.
ADMIN_SEED_NAME=Administrador
ADMIN_SEED_EMAIL=admin@londono.local
ADMIN_SEED_PASSWORD=ChangeMe123!
