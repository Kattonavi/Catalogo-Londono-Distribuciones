# =====================================================================
# Plantilla de variables de entorno del BACKEND (SIN secretos reales).
# Copia a `.env` (gitignored) para uso local, o configúralas en Railway.
# Spring Boot NO carga `.env` automáticamente: expórtalas en tu shell/IDE
# o en el panel de variables del servicio en Railway.
#
# En desarrollo local puedes dejarlas vacías: application.yml tiene defaults
# de desarrollo seguros (localhost, admin@londono.local, etc.).
# En PRODUCCIÓN (Railway) debes definirlas todas con valores reales.
# =====================================================================

# --- Base de datos (PostgreSQL) ---
# Local (Docker Compose, puerto por defecto):
#   DATABASE_URL=jdbc:postgresql://localhost:5432/londono_distribuciones
# Railway (referencia al servicio Postgres; NO escribas credenciales reales aquí):
#   DATABASE_URL=jdbc:postgresql://${{Postgres.PGHOST}}:${{Postgres.PGPORT}}/${{Postgres.PGDATABASE}}
#   DATABASE_USERNAME=${{Postgres.PGUSER}}
#   DATABASE_PASSWORD=${{Postgres.PGPASSWORD}}
DATABASE_URL=
DATABASE_USERNAME=
DATABASE_PASSWORD=

# --- JWT ---
# JWT_SECRET: cadena aleatoria de >= 32 caracteres (256 bits para HS256).
# IMPORTANTE: las expiraciones están en MILISEGUNDOS (así las lee el backend).
#   900000     = 15 minutos
#   604800000  = 7 días
JWT_SECRET=
JWT_ACCESS_EXPIRATION=900000
JWT_REFRESH_EXPIRATION=604800000

# --- Frontend / CORS ---
# URL pública del frontend (sin barra final). En Railway: la URL del servicio frontend.
#   Local: http://localhost:3000
FRONTEND_URL=

# --- Contacto ---
# Número de WhatsApp de la distribuidora (código de país, solo dígitos).
WHATSAPP_PHONE_NUMBER=

# --- Seed del administrador inicial (solo se crea si la tabla users está vacía) ---
# Cambia la contraseña tras el primer arranque en cualquier entorno real.
ADMIN_SEED_EMAIL=
ADMIN_SEED_PASSWORD=
ADMIN_SEED_NAME=

# --- Cloudinary (imágenes) ---
# Si se dejan vacías, el backend ARRANCA igual, pero la subida de imágenes fallará
# hasta configurar credenciales válidas. NUNCA commitees el API secret.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Puerto (opcional) ---
# Railway inyecta PORT automáticamente; el backend lo respeta (server.port=${PORT:8080}).
# Solo defínelo si quieres forzar un puerto en local.
PORT=
