###############################################################################
# seed-catalog-dev.http
#
# Datos de prueba de catálogo para DESARROLLO LOCAL de Londoño Distribuciones.
# Pobla marcas, categorías y productos representativos vía la API admin.
#
# Cómo usarlo:
#   - VS Code: extensión "REST Client" (humao.rest-client).
#   - IntelliJ IDEA / WebStorm: cliente HTTP integrado.
#   Ejecuta las requests de arriba hacia abajo (la de login debe ir primero;
#   las demás reutilizan su token y los IDs de las respuestas encadenadas).
#
# Requisitos:
#   - Backend corriendo en {{host}} (ver backend/README.md).
#   - Admin sembrado (ADMIN_SEED_*). Por defecto: admin@londono.local / ChangeMe123!
#
# Seguridad:
#   - NO contiene tokens ni secretos reales: el token se obtiene en runtime
#     desde la respuesta del login ({{login.response.body.accessToken}}).
#   - Cambia las credenciales/host según tu entorno.
###############################################################################

@host = http://localhost:8080
@adminEmail = admin@londono.local
@adminPassword = ChangeMe123!

### Login (obtiene el accessToken; las siguientes requests lo reutilizan)
# @name login
POST {{host}}/api/auth/login
Content-Type: application/json

{ "email": "{{adminEmail}}", "password": "{{adminPassword}}" }

@token = {{login.response.body.accessToken}}

#============================== MARCAS =======================================

### Marca: Glacial
# @name bGlacial
POST {{host}}/api/admin/brands
Authorization: Bearer {{token}}
Content-Type: application/json

{ "name": "Glacial" }

### Marca: Coca-Cola
# @name bCoca
POST {{host}}/api/admin/brands
Authorization: Bearer {{token}}
Content-Type: application/json

{ "name": "Coca-Cola" }

### Marca: Postobón
# @name bPostobon
POST {{host}}/api/admin/brands
Authorization: Bearer {{token}}
Content-Type: application/json

{ "name": "Postobón" }

### Marca: Pony Malta
# @name bPony
POST {{host}}/api/admin/brands
Authorization: Bearer {{token}}
Content-Type: application/json

{ "name": "Pony Malta" }

### Marca: INC
# @name bInc
POST {{host}}/api/admin/brands
Authorization: Bearer {{token}}
Content-Type: application/json

{ "name": "INC" }

