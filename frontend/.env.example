# Plantilla de variables de entorno del frontend (SIN secretos reales).
# Copia este archivo a `.env.local` (ignorado por git) y completa los valores.
#
# Estas variables son PUBLICAS (prefijo NEXT_PUBLIC_): se incluyen en el bundle
# del navegador. No pongas aqui secretos del backend (JWT, Cloudinary API secret, etc.).

# URL base del backend (API REST). Sin barra final.
# Ej. local: http://localhost:8080
NEXT_PUBLIC_API_URL=http://localhost:8080

# Numero de WhatsApp de la distribuidora (con codigo de pais, solo digitos).
# Ej. Colombia: 573001234567
NEXT_PUBLIC_WHATSAPP_PHONE_NUMBER=
