# =====================================================================
# Plantilla de variables de entorno del FRONTEND (SIN secretos reales).
# Copia a `.env.local` (gitignored) para desarrollo, o configúralas en Railway.
#
# Son PÚBLICAS (prefijo NEXT_PUBLIC_): se incluyen en el bundle del navegador.
# NO pongas aquí secretos del backend (JWT, Cloudinary API secret, etc.).
# Se inlinean en tiempo de BUILD: si las cambias, hay que reconstruir.
# =====================================================================

# URL base del backend (API REST), sin barra final.
#   Local:   http://localhost:8080
#   Railway: la URL pública del servicio backend (https://<backend>.up.railway.app)
NEXT_PUBLIC_API_URL=

# Número de WhatsApp de la distribuidora (código de país, solo dígitos).
#   Ej. Colombia: 573001234567
NEXT_PUBLIC_WHATSAPP_PHONE_NUMBER=

# Catálogo demo de desarrollo (lib/demoData.ts). Se muestra SOLO cuando la
# fuente real viene vacía (sin backend o base sin productos); nunca oculta
# productos reales.
#   SOLO el valor `off` lo desactiva. Vacío o ausente = ACTIVO (on).
#   ⚠ En PRODUCCIÓN (Railway) pon explícitamente `off` para no mostrar
#     productos de muestra si el backend queda vacío o caído.
NEXT_PUBLIC_DEMO_FALLBACK=
